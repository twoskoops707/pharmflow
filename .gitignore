bundled/_chromium_android_Android_Arm64.zip

# Freebuff local memory + secrets — never commit
LOCAL_MEMORY.md
.env

# Locally built EXEs / PyInstaller onefile specs at repo root (CI builds canonical EXEs)
/CPharmAgent.exe
/CPharmWatchdog.exe
/CPharmMuMuSetup.exe
/CPharmSetup.exe
/CPharmAgent.spec
/CPharmWatchdog.spec
/CPharmMuMuSetup.spec

# CI-generated at build time; do not commit a local build stamp
/wizard/assets/build_info.json

# Browser APKs fetched at build time (tools/prefetch_browser_apks.py); they
# are embedded into the EXE by CI, never committed to the repo (~400 MB).
/wizard/bundled/
/bundled/apks/

# Local Ollama/FreeLLMAPI cursor-agent bridge runtime state — per-machine
# tunnel URLs, bearer tokens, and logs. Never committed (defense in depth;
# these are also just per-run generated state, not source).
scripts/cursor-llm/*.env
scripts/cursor-llm/*.json
scripts/cursor-llm/*.log
wizard/assets/build_info.json
