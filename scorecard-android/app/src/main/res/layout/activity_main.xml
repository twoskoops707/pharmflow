<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connection card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_laptop"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/laptopUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/laptop_hint"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:importantForAutofill="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/FarmActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_connect"
                    app:backgroundTint="@color/teal_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/statusDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/status_off"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/not_connected"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusPhones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:text="@string/tap_connect_first"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Big action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindPhones"
            style="@style/FarmBigButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:text="@string/btn_find_phones"
            app:backgroundTint="@color/sky_blue"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGo"
            style="@style/FarmBigButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="10dp"
            android:text="@string/btn_go"
            app:backgroundTint="@color/go_green"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/FarmBigButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_stop"
            app:backgroundTint="@color/stop_red"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTor"
                style="@style/FarmHalfButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_tor"
                app:backgroundTint="@color/purple_soft"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textTop"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewFaces"
                style="@style/FarmHalfButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_new_faces"
                app:backgroundTint="@color/orange_soft"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textTop"
                app:iconSize="22dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMoney"
            style="@style/FarmBigButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_money"
            app:backgroundTint="@color/money_gold"
            app:icon="@drawable/ic_money"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp" />

        <TextView
            android:id="@+id/messageLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
